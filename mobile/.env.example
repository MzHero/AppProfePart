# Copiar a .env.local (no se sube a git) y completar.
# Sin estas variables la app usa los datos mock en memoria.
#
# Desarrollo local (desde la raíz del repo: npx supabase@3.1.0 start):
#   EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#   (en un teléfono físico usar la IP de la PC en la red, ej. http://192.168.0.10:54321)
#   EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY = "Publishable key" que imprime `supabase status`
#
# Proyecto en la nube: Supabase Dashboard -> Project Settings -> API Keys.
# NUNCA poner acá la secret key / service_role: saltea toda la seguridad (RLS).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
